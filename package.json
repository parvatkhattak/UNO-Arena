    "@react-navigation/stack": "^7.9.3",
    "expo": "~56.0.15",
    "expo-av": "^16.0.8",
    "expo-font": "^56.0.5",
    "expo-haptics": "^56.0.3",
    "expo-linear-gradient": "^56.0.4",
    "expo-network": "~56.0.5",
    "expo-splash-screen": "~56.0.12",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-tcp-socket": "^6.4.1",
    "react-native-worklets": "0.8.3",
    "uuid": "^9.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "@types/uuid": "^9.0.0",
    "babel-preset-expo": "~56.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.5",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --no-cache",
    "build:android:preview": "npx eas build --platform android --profile preview",
    "build:android:prod": "npx eas build --platform android --profile production",
    "build:ios:prod": "npx eas build --platform ios --profile production"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-tcp-socket",
          "expo-av"
        ]
      }
    }
  }
